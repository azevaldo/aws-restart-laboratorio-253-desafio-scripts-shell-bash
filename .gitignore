```gitignore
# Chaves privadas
*.pem
*.ppk
*.key

# Credenciais e configurações da AWS
.aws/
credentials
config

# Arquivos de ambiente
.env
.env.*
!.env.example

# Arquivos do sistema operacional
.DS_Store
Thumbs.db

# Arquivos temporários
*.log
*.tmp

# Arquivos compactados
*.zip
*.tar
*.tar.gz
```
